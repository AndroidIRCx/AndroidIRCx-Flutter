#!/bin/bash
# AppImage entry point. Resolves its own location, points the dynamic loader at
# the bundled Flutter libraries, and launches the app. The Flutter engine finds
# data/ relative to the real executable path, so running via this wrapper works.
HERE="$(dirname "$(readlink -f "${0}")")"
export LD_LIBRARY_PATH="${HERE}/usr/bin/lib:${LD_LIBRARY_PATH}"
exec "${HERE}/usr/bin/androidircx" "$@"
